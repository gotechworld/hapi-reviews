{
  "name": "reviews-api",
  "version": "1.0.0",
  "description": "Product/Seller Reviews& Questions Data API",
  "main": "dist/server.js",
  "repository": "https://gitlab.altex.ro/ams/hapi-reviews.git",
  "scripts": {
    "start": "nodemon --exec babel-node src/server.js",
    "build": "babel src --out-dir dist --copy-files",
    "serve": "node dist/server.js",
    "command:aggregate-summaries": "node dist/command.js --command aggregate_summaries",
    "dev:command:aggregate-summaries": "nodemon --exec babel-node src/command.js --command aggregate_summaries",
    "command:aggregate-brands": "node dist/command.js --command aggregate_brands",
    "dev:command:aggregate-brands": "nodemon --exec babel-node src/command.js --command aggregate_brands",
    "command:recalculate-reviews-rating": "node dist/command.js --command recalculate_reviews_rating",
    "dev:command:recalculate-reviews-rating": "nodemon --exec babel-node src/command.js --command recalculate_reviews_rating",
    "command:add-default-review-type": "node dist/command.js --command add_default_review_types",
    "dev:command:add-default-review-type": "nodemon --exec babel-node src/command.js --command add_default_review_types",
    "command:verify-buyer": "node dist/command.js --command verify_buyer",
    "dev:command:verify-buyer": "nodemon --exec babel-node src/command.js --command verify_buyer"
  },
  "author": "Gabriel Cioropina <gabriel.cioropina@axsys.ro>",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^7.4.11",
    "@hapi/catbox-redis": "^5.0.2",
    "@hapi/glue": "^6.1.0",
    "@hapi/hapi": "^18.4.1",
    "@hapi/inert": "^5.2.1",
    "@hapi/joi": "^16.1.7",
    "@hapi/vision": "^5.4.0",
    "amqplib": "^0.5.6",
    "apisauce": "^1.1.1",
    "core-js": "^3.1.4",
    "fast-csv": "^2.4.1",
    "form-data": "^4.0.0",
    "hapi-alerto": "git+ssh://git@gitlab.altex.ro:plug/hapi-alerto.git#release/1.0.0",
    "hapi-internal-bridge": "git+ssh://git@gitlab.altex.ro:plug/hapi-internal-bridge.git#v1.1.0",
    "hapi-panda-mongoose": "^0.1.0",
    "hapi-pino": "^6.0.0",
    "hapi-swagger": "^10.0.2",
    "lodash": "^4.17.19",
    "minimist": "^1.2.5",
    "mongoose": "^5.2.10",
    "qs": "^6.9.4",
    "require-dir": "^1.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.5.5",
    "@babel/core": "^7.5.5",
    "@babel/node": "^7.5.5",
    "@babel/preset-env": "^7.5.5",
    "@hapi/eslint-config-hapi": "^12.1.0",
    "@hapi/eslint-plugin-hapi": "^4.3.5",
    "babel-eslint": "^10.0.2",
    "eslint": "^6.1.0",
    "nodemon": "^1.18.10"
  }
}
